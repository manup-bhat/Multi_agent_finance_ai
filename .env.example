# ══════════════════════════════════════════════════════════════════
# Multi-Agent India Financial Prediction Engine — v3.0
# 1. Copy this file → .env
# 2. Fill in ONLY the 3 API keys marked ← FILL THIS
# 3. Everything else works as-is — do not change unless you know why
# NEVER commit .env to git — add .env to .gitignore
# ══════════════════════════════════════════════════════════════════

# ── LLM APIs ──────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here          # ← FILL THIS | https://aistudio.google.com/
GROQ_API_KEY=your_groq_api_key_here              # ← FILL THIS | https://console.groq.com/
FINLIGHT_API_KEY=your_finlight_api_key_here      # ← FILL THIS | https://finlight.me/ (10K req/month free)

# ── Social Sentiment: StockTwits (NO KEY NEEDED) ──────────────────
# Public API — no registration required
# Symbol format for Indian stocks: {NSE_SYMBOL}.IN  e.g. RELIANCE.IN, TCS.IN
STOCKTWITS_BASE_URL=https://api.stocktwits.com/api/2/streams/symbol
STOCKTWITS_RATE_LIMIT_DELAY=18                   # seconds between calls (200 req/hour free limit)

# ── Social Sentiment: India RSS Feeds (NO KEY NEEDED) ─────────────
# Parsed with feedparser — pip install feedparser
RSS_ECONOMIC_TIMES_MARKETS=https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms
RSS_ECONOMIC_TIMES_STOCKS=https://economictimes.indiatimes.com/markets/stocks/rssfeeds/2146842.cms
RSS_LIVEMINT_MARKETS=https://www.livemint.com/rss/markets
RSS_BUSINESS_STANDARD=https://www.business-standard.com/rss/markets-106.rss
RSS_THE_HINDU_MARKETS=https://www.thehindu.com/business/markets/feeder/default.rss
RSS_INVESTING_COM_INDIA=https://in.investing.com/rss/news.rss
RSS_CACHE_TTL_MINUTES=30

# ── Social Sentiment: MoneyControl Scraper (NO KEY NEEDED) ────────
# Scraped with requests + BeautifulSoup — pip install beautifulsoup4
MONEYCONTROL_NEWS_URL=https://www.moneycontrol.com/news/
MONEYCONTROL_SCRAPE_DELAY=2                      # seconds between requests to avoid blocks

# ── GDELT Macro Sentiment (NO KEY NEEDED) ─────────────────────────
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_SOURCECOUNTRY=IN
GDELT_MAXRECORDS=50
GDELT_CACHE_TTL_MINUTES=60

# ── Optional: ICICI Breeze API ────────────────────────────────────
# BREEZE_API_KEY=your_breeze_api_key              # https://api.icicidirect.com/
# BREEZE_API_SECRET=your_breeze_api_secret

# ── Database ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=india_engine
POSTGRES_USER=engine_user
POSTGRES_PASSWORD=change_this_strong_password    # ← change this before production
SQLITE_PATH=./storage/prediction_logs/predictions.db

# ── MLflow ────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=india_stock_prediction

# ── Phoenix (Arize Observability) ─────────────────────────────────
PHOENIX_HOST=localhost
PHOENIX_PORT=6006

# ── Qdrant ────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=india_finance_docs

# ── App Config ────────────────────────────────────────────────────
APP_ENV=development                              # development | production
LOG_LEVEL=INFO
IST_TIMEZONE=Asia/Kolkata
API_PORT=8000
STREAMLIT_PORT=8501

# ── SEBI Compliance ───────────────────────────────────────────────
MAX_OPS_PER_SECOND=10                            # Hard limit from SEBI April 2026
STATIC_IP_REQUIRED=false                         # Set true in production